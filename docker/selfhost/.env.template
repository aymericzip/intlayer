# Intlayer self-hosting — Docker Compose environment file
#
#   cp .env.template .env
#
# Fill in every value marked TODO. Docker Compose reads this file both for the
# ${…} substitutions in docker-compose.yml and as the backend's env_file, so
# write bare values (no quotes) and keep comments on their own lines.
# Reference: https://intlayer.org/doc/self-hosting

# --- Secrets (required) --------------------------------------------------------
# Generate each one with: openssl rand -hex 32
# Rotating BETTER_AUTH_SECRET invalidates every session; rotating
# S3_SECRET_ACCESS_KEY orphans the objects already stored in MinIO.
# TODO
BETTER_AUTH_SECRET=
# TODO
S3_SECRET_ACCESS_KEY=

# --- Transactional email (required, pick ONE) ----------------------------------
# First-run setup enforces email verification, so a mailer must work before you
# can sign in. Configure either Resend or an SMTP relay. When MAIL_SMTP_HOST is
# set, SMTP is used and RESEND_API_KEY is ignored.
#
# Option A — Resend (https://resend.com)
# TODO
RESEND_API_KEY=
#
# Option B — SMTP relay (uncomment and fill in)
# MAIL_SMTP_HOST=smtp.example.com
# MAIL_SMTP_PORT=587
# MAIL_SMTP_SECURE=false
# MAIL_SMTP_USER=
# MAIL_SMTP_PASSWORD=
#
# Sender for either option. Accepts a bare address or "Name <email>".
# MAIL_FROM=Intlayer <no-reply@example.com>

# --- Host ports (optional) -----------------------------------------------------
# Only the host side of the port mappings. The published app image has
# http://localhost:3000 / :3100 / :9000 compiled in, so keep the defaults unless
# you build your own images with matching VITE_* build args.
# INTLAYER_APP_PORT=3000
# INTLAYER_API_PORT=3100
# INTLAYER_S3_PORT=9000
# INTLAYER_CONSOLE_PORT=9001

# --- Images (optional) ---------------------------------------------------------
# INTLAYER_IMAGE_TAG=latest

# --- Object storage (optional) -------------------------------------------------
# S3_BUCKET_NAME=intlayer
# S3_ACCESS_KEY_ID=intlayer

# --- Optional: AI features -----------------------------------------------------
# Enables AI-assisted translation and content audit.
# OPENAI_API_KEY=

# --- Optional: OAuth providers -------------------------------------------------
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITLAB_CLIENT_ID=
# GITLAB_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
