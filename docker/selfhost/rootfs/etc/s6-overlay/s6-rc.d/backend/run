#!/command/with-contenv bash
# Fastify API on :3100. Depends on mongo (replica set up), redis and minio bucket.
# If a dependency is briefly unavailable the process exits and s6 restarts it.
source /etc/s6-overlay/scripts/s3-credentials.sh
export PORT=3100
cd /workspace/apps/backend
exec bun dist/esm/index.mjs
