{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@utils/ts-config-types",
  "include": ["src/**/*", "types/**/*"],
  "exclude": ["**/*.test.*"],
  "compilerOptions": {
    "strictNullChecks": true,
    "rootDir": "./src",
    "outDir": "dist/types",
    "paths": {
      "@intlayer/api": ["./src/index.ts"],
      "intlayer-editor": ["../../intlayer-editor/server/dist/export"]
    }
  }
}
