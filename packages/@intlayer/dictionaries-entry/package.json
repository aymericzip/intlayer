{
  "name": "@intlayer/dictionaries-entry",
  "version": "9.5.9",
  "private": false,
  "description": "Provides the entry points for the generated Intlayer dictionaries (merged, unmerged, remote, dynamic, fetch), designed to be aliased by bundlers like Webpack, Vite, Turbopack, esbuild and Metro.",
  "keywords": [
    "intlayer",
    "alias",
    "dictionaries",
    "entry",
    "unmerged",
    "remote",
    "dynamic",
    "fetch"
  ],
  "homepage": "https://intlayer.org",
  "bugs": {
    "url": "https://github.com/aymericzip/intlayer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aymericzip/intlayer.git"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Aymeric PINEAU",
    "url": "https://github.com/aymericzip"
  },
  "contributors": [
    {
      "name": "Aymeric Pineau",
      "email": "ay.pineau@gmail.com",
      "url": "https://github.com/aymericzip"
    }
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "browser": "./dist/esm/index.browser.mjs",
      "require": "./dist/cjs/index.cjs",
      "import": "./dist/esm/index.mjs"
    },
    "./unmerged": {
      "types": "./dist/types/unmerged.d.ts",
      "browser": "./dist/esm/unmerged.browser.mjs",
      "require": "./dist/cjs/unmerged.cjs",
      "import": "./dist/esm/unmerged.mjs"
    },
    "./remote": {
      "types": "./dist/types/remote.d.ts",
      "browser": "./dist/esm/remote.browser.mjs",
      "require": "./dist/cjs/remote.cjs",
      "import": "./dist/esm/remote.mjs"
    },
    "./dynamic": {
      "types": "./dist/types/dynamic.d.ts",
      "browser": "./dist/esm/dynamic.browser.mjs",
      "require": "./dist/cjs/dynamic.cjs",
      "import": "./dist/esm/dynamic.mjs"
    },
    "./fetch": {
      "types": "./dist/types/fetch.d.ts",
      "browser": "./dist/esm/fetch.browser.mjs",
      "require": "./dist/cjs/fetch.cjs",
      "import": "./dist/esm/fetch.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.mjs",
  "types": "dist/types/index.d.ts",
  "typesVersions": {
    "*": {
      "unmerged": [
        "./dist/types/unmerged.d.ts"
      ],
      "remote": [
        "./dist/types/remote.d.ts"
      ],
      "dynamic": [
        "./dist/types/dynamic.d.ts"
      ],
      "fetch": [
        "./dist/types/fetch.d.ts"
      ],
      "package.json": [
        "./package.json"
      ]
    }
  },
  "files": [
    "./dist",
    "./package.json"
  ],
  "scripts": {
    "build": "bun --bun tsdown --config tsdown.config.ts",
    "build:ci": "bun --bun tsdown --config tsdown.config.ts",
    "clean": "bun --bun rimraf ./dist .turbo",
    "dev": "bun --bun tsdown --config tsdown.config.ts --watch",
    "format": "bun --bun biome format . --check",
    "format:fix": "bun --bun biome format --write .",
    "lint": "bun --bun biome lint .",
    "lint:fix": "bun --bun biome lint --write .",
    "process-files": "ts-node src/transpiler/processFilesCLI.ts --dir $npm_config_dir --extension $npm_config_extension --no-node-snapshot",
    "prepublish": "cp -f ../../../README.md ./README.md",
    "publish": "bun publish || true",
    "publish:canary": "bun publish --access public --tag canary || true",
    "publish:ci": "bun ../../../scripts/publish-package.mjs",
    "publish:latest": "bun publish --access public --tag latest || true",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest",
    "typecheck": "tsc --noEmit --project tsconfig.types.json"
  },
  "dependencies": {
    "@intlayer/config": "workspace:*"
  },
  "devDependencies": {
    "@intlayer/types": "workspace:*",
    "@types/node": "^22",
    "@utils/ts-config": "workspace:*",
    "@utils/ts-config-types": "workspace:*",
    "@utils/tsdown-config": "workspace:*",
    "rimraf": "6.1.3",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=14.18"
  },
  "bug": {
    "url": "https://github.com/aymericzip/intlayer/issues"
  }
}
