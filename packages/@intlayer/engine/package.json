{
  "name": "@intlayer/engine",
  "version": "9.7.1",
  "private": false,
  "description": "Scans and builds Intlayer declaration files into dictionaries based on Intlayer configuration.",
  "keywords": [
    "application",
    "file",
    "intlayer",
    "javascript",
    "json",
    "transpile",
    "typescript",
    "watcher"
  ],
  "homepage": "https://intlayer.org",
  "bugs": {
    "url": "https://github.com/aymericzip/intlayer/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Aymeric PINEAU",
    "url": "https://github.com/aymericzip"
  },
  "contributors": [
    {
      "name": "Aymeric Pineau",
      "email": "ay.pineau@gmail.com",
      "url": "https://github.com/aymericzip"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aymericzip/intlayer.git"
  },
  "files": [
    "./dist",
    "./package.json"
  ],
  "sideEffects": false,
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.mjs",
  "types": "dist/types/index.d.ts",
  "typesVersions": {
    "*": {
      "watcher": [
        "./dist/types/watcher.d.ts"
      ],
      "build": [
        "./dist/types/build.d.ts"
      ],
      "cli": [
        "./dist/types/cli.d.ts"
      ],
      "logConfigDetails": [
        "./dist/types/logConfigDetails.d.ts"
      ],
      "utils": [
        "./dist/types/utils/index.d.ts"
      ],
      "syncPluginKit": [
        "./dist/types/syncPluginKit/index.d.ts"
      ],
      "listDictionaries": [
        "./dist/types/listDictionariesPath.d.ts"
      ],
      "scan": [
        "./dist/types/scan/index.d.ts"
      ],
      "scan/detection": [
        "./dist/types/scan/detection/index.d.ts"
      ],
      "docReview": [
        "./dist/types/docReview/index.d.ts"
      ],
      "contentDeclaration": [
        "./dist/types/writeContentDeclaration/renderContentDeclaration.d.ts"
      ],
      "package.json": [
        "./package.json"
      ]
    }
  },
  "exports": {
    "./watcher": {
      "types": "./dist/types/watcher.d.ts",
      "require": "./dist/cjs/watcher.cjs",
      "import": "./dist/esm/watcher.mjs"
    },
    "./build": {
      "types": "./dist/types/build.d.ts",
      "require": "./dist/cjs/build.cjs",
      "import": "./dist/esm/build.mjs"
    },
    "./cli": {
      "types": "./dist/types/cli.d.ts",
      "require": "./dist/cjs/cli.cjs",
      "import": "./dist/esm/cli.mjs"
    },
    "./logConfigDetails": {
      "types": "./dist/types/logConfigDetails.d.ts",
      "require": "./dist/cjs/logConfigDetails.cjs",
      "import": "./dist/esm/logConfigDetails.mjs"
    },
    "./utils": {
      "types": "./dist/types/utils/index.d.ts",
      "require": "./dist/cjs/utils/index.cjs",
      "import": "./dist/esm/utils/index.mjs"
    },
    "./syncPluginKit": {
      "types": "./dist/types/syncPluginKit/index.d.ts",
      "require": "./dist/cjs/syncPluginKit/index.cjs",
      "import": "./dist/esm/syncPluginKit/index.mjs"
    },
    "./listDictionaries": {
      "types": "./dist/types/listDictionariesPath.d.ts",
      "require": "./dist/cjs/listDictionariesPath.cjs",
      "import": "./dist/esm/listDictionariesPath.mjs"
    },
    "./scan": {
      "types": "./dist/types/scan/index.d.ts",
      "require": "./dist/cjs/scan/index.cjs",
      "import": "./dist/esm/scan/index.mjs"
    },
    "./scan/detection": {
      "types": "./dist/types/scan/detection/index.d.ts",
      "require": "./dist/cjs/scan/detection/index.cjs",
      "import": "./dist/esm/scan/detection/index.mjs"
    },
    "./docReview": {
      "types": "./dist/types/docReview/index.d.ts",
      "require": "./dist/cjs/docReview/index.cjs",
      "import": "./dist/esm/docReview/index.mjs"
    },
    "./contentDeclaration": {
      "types": "./dist/types/writeContentDeclaration/renderContentDeclaration.d.ts",
      "require": "./dist/cjs/writeContentDeclaration/renderContentDeclaration.cjs",
      "import": "./dist/esm/writeContentDeclaration/renderContentDeclaration.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun --bun tsdown --config tsdown.config.ts",
    "build:ci": "bun --bun tsdown --config tsdown.config.ts",
    "clean": "bun --bun rimraf ./dist .turbo",
    "dev": "bun --bun tsdown --config tsdown.config.ts --watch",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "prepublish": "cp -f ../../../README.md ./README.md",
    "publish": "bun publish || true",
    "publish:canary": "bun publish --access public --tag canary || true",
    "publish:ci": "bun ../../../scripts/publish-package.mjs",
    "publish:latest": "bun publish --access public --tag latest || true",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest",
    "typecheck": "tsc --noEmit --project tsconfig.types.json"
  },
  "dependencies": {
    "@intlayer/api": "workspace:*",
    "@intlayer/config": "workspace:*",
    "@intlayer/core": "workspace:*",
    "@intlayer/dictionaries-entry": "workspace:*",
    "@intlayer/types": "workspace:*",
    "@parcel/watcher": "2.6.0",
    "defu": "6.1.7",
    "fast-glob": "3.3.3",
    "recast": "0.24.0",
    "simple-git": "4.0.2",
    "zod-to-ts": "2.1.0"
  },
  "devDependencies": {
    "@types/node": "^26",
    "@utils/ts-config": "workspace:*",
    "@utils/ts-config-types": "workspace:*",
    "@utils/tsdown-config": "workspace:*",
    "rimraf": "6.1.4",
    "tsdown": "0.23.4",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@intlayer/babel": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@intlayer/babel": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=14.18"
  },
  "bug": {
    "url": "https://github.com/aymericzip/intlayer/issues"
  }
}
