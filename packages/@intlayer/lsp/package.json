{
  "name": "@intlayer/lsp",
  "version": "9.8.0-canary.0",
  "private": false,
  "description": "Intlayer Language Server. Handle LSP to help IDE and AI agent to use Intlayer",
  "keywords": [
    "agent",
    "ai",
    "ide",
    "intlayer",
    "lsp",
    "mcp-language-server",
    "mcp-lsp"
  ],
  "homepage": "https://intlayer.org",
  "bugs": {
    "url": "https://github.com/aymericzip/intlayer/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Aymeric PINEAU",
    "url": "https://github.com/aymericzip"
  },
  "contributors": [
    {
      "name": "Aymeric Pineau",
      "email": "ay.pineau@gmail.com",
      "url": "https://github.com/aymericzip"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aymericzip/intlayer.git"
  },
  "bin": {
    "intlayer-lsp": "./dist/esm/index.mjs"
  },
  "files": [
    "./dist",
    "./package.json"
  ],
  "sideEffects": false,
  "main": "dist/esm/index.mjs",
  "module": "dist/esm/index.mjs",
  "types": "dist/types/index.d.ts",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types/index.d.ts"
      ],
      "utils": [
        "./dist/types/utils.d.ts"
      ],
      "package.json": [
        "./package.json"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.mjs"
    },
    "./utils": {
      "types": "./dist/types/utils.d.ts",
      "import": "./dist/esm/utils.mjs",
      "default": "./dist/esm/utils.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun --bun tsdown --config tsdown.config.ts",
    "build:ci": "bun --bun tsdown --config tsdown.config.ts",
    "clean": "bun --bun rimraf ./dist .turbo",
    "dev": "bun --bun tsdown --config tsdown.config.ts --watch",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "prepublish": "cp -f ../../../README.md ./README.md",
    "publish": "bun publish || true",
    "publish:canary": "bun publish --access public --tag canary || true",
    "publish:ci": "bun ../../../scripts/publish-package.mjs",
    "publish:latest": "bun publish --access public --tag latest || true",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest",
    "typecheck": "tsc --noEmit --project tsconfig.types.json"
  },
  "dependencies": {
    "@intlayer/config": "workspace:*",
    "@intlayer/dictionaries-entry": "workspace:*",
    "@intlayer/engine": "workspace:*",
    "@intlayer/types": "workspace:*",
    "oxc-parser": "0.158.0",
    "vscode-languageserver": "11.0.0",
    "vscode-languageserver-textdocument": "1.0.16"
  },
  "devDependencies": {
    "@types/node": "^26",
    "@utils/ts-config": "workspace:*",
    "@utils/ts-config-types": "workspace:*",
    "@utils/tsdown-config": "workspace:*",
    "rimraf": "6.1.4",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=14.18"
  }
}
