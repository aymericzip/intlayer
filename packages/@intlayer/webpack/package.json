{
  "name": "@intlayer/webpack",
  "version": "9.8.0-canary.0",
  "private": false,
  "description": "Webpack plugin for seamless integration with Intlayer, enhancing JavaScript apps built with React, Next.js and more.",
  "keywords": [
    "application",
    "file",
    "intlayer",
    "javascript",
    "json",
    "transpile",
    "typescript",
    "webpack"
  ],
  "homepage": "https://intlayer.org",
  "bugs": {
    "url": "https://github.com/aymericzip/intlayer/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Aymeric PINEAU",
    "url": "https://github.com/aymericzip"
  },
  "contributors": [
    {
      "name": "Aymeric Pineau",
      "email": "ay.pineau@gmail.com",
      "url": "https://github.com/aymericzip"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aymericzip/intlayer.git"
  },
  "files": [
    "./dist",
    "./package.json"
  ],
  "sideEffects": false,
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.mjs",
  "types": "dist/types/index.d.ts",
  "typesVersions": {
    "*": {
      "package.json": [
        "./package.json"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "require": "./dist/cjs/index.cjs",
      "import": "./dist/esm/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun --bun tsdown --config tsdown.config.ts",
    "build:ci": "bun --bun tsdown --config tsdown.config.ts",
    "clean": "bun --bun rimraf ./dist .turbo",
    "dev": "bun --bun tsdown --config tsdown.config.ts --watch",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "prepublish": "cp -f ../../../README.md ./README.md",
    "publish": "bun publish || true",
    "publish:canary": "bun publish --access public --tag canary || true",
    "publish:ci": "bun ../../../scripts/publish-package.mjs",
    "publish:latest": "bun publish --access public --tag latest || true",
    "serve": "webpack serve --config ./webpack.config.ts",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest",
    "transpile": "webpack --config ./webpack.config.ts",
    "typecheck": "tsc --noEmit --project tsconfig.types.json",
    "watch": "webpack --config ./webpack.config.ts --watch"
  },
  "dependencies": {
    "@intlayer/config": "workspace:*",
    "@intlayer/dictionaries-entry": "workspace:*",
    "@intlayer/engine": "workspace:*",
    "@intlayer/types": "workspace:*",
    "fast-glob": "3.3.3"
  },
  "devDependencies": {
    "@types/node": "^26",
    "@utils/ts-config": "workspace:*",
    "@utils/ts-config-types": "workspace:*",
    "@utils/tsdown-config": "workspace:*",
    "rimraf": "6.1.4",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "webpack": "5.112.2",
    "webpack-dev-server": "6.1.0"
  },
  "peerDependencies": {
    "webpack": ">=5.0.0",
    "webpack-dev-server": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "webpack": {
      "optional": true
    },
    "webpack-dev-server": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=14.18"
  },
  "bug": {
    "url": "https://github.com/aymericzip/intlayer/issues"
  }
}
