{
  "name": "@intlayer/babel",
  "version": "9.7.1",
  "private": false,
  "description": "A Babel plugin for Intlayer that transforms declaration files and provides internationalization features during the build process according to the Intlayer configuration.",
  "keywords": [
    "babel",
    "file",
    "internationalization",
    "intlayer",
    "javascript",
    "json",
    "plugin",
    "transpile",
    "typescript"
  ],
  "homepage": "https://intlayer.org",
  "bugs": {
    "url": "https://github.com/aymericzip/intlayer/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Aymeric PINEAU",
    "url": "https://github.com/aymericzip"
  },
  "contributors": [
    {
      "name": "Aymeric Pineau",
      "email": "ay.pineau@gmail.com",
      "url": "https://github.com/aymericzip"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aymericzip/intlayer.git"
  },
  "files": [
    "./dist",
    "./package.json"
  ],
  "sideEffects": false,
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.mjs",
  "types": "dist/types/index.d.ts",
  "typesVersions": {
    "*": {
      "babelParser": [
        "./dist/types/babelParser.d.ts"
      ],
      "package.json": [
        "./package.json"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "require": "./dist/cjs/index.cjs",
      "import": "./dist/esm/index.mjs"
    },
    "./babelParser": {
      "types": "./dist/types/babelParser.d.ts",
      "require": "./dist/cjs/babelParser.cjs",
      "import": "./dist/esm/babelParser.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun --bun tsdown --config tsdown.config.ts",
    "build:ci": "bun --bun tsdown --config tsdown.config.ts",
    "clean": "bun --bun rimraf ./dist .turbo",
    "dev": "bun --bun tsdown --config tsdown.config.ts --configLoader runner --watch",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "prepublish": "cp -f ../../../README.md ./README.md",
    "publish": "bun publish || true",
    "publish:canary": "bun publish --access public --tag canary || true",
    "publish:ci": "bun ../../../scripts/publish-package.mjs",
    "publish:latest": "bun publish --access public --tag latest || true",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest",
    "typecheck": "tsc --noEmit --project tsconfig.types.json"
  },
  "dependencies": {
    "@babel/core": "8.1.0",
    "@babel/generator": "8.1.0",
    "@babel/parser": "8.1.0",
    "@babel/plugin-syntax-jsx": "8.0.1",
    "@babel/traverse": "8.1.0",
    "@babel/types": "8.1.0",
    "@intlayer/config": "workspace:*",
    "@intlayer/core": "workspace:*",
    "@intlayer/dictionaries-entry": "workspace:*",
    "@intlayer/engine": "workspace:*",
    "@intlayer/types": "workspace:*"
  },
  "devDependencies": {
    "@babel/plugin-syntax-jsx": "8.0.1",
    "@types/babel__core": "7.20.5",
    "@types/babel__generator": "7.27.0",
    "@types/babel__traverse": "7.28.0",
    "@types/node": "^26",
    "@utils/ts-config": "workspace:*",
    "@utils/ts-config-types": "workspace:*",
    "@utils/tsdown-config": "workspace:*",
    "@vitejs/plugin-react": "6.3.0",
    "rimraf": "6.1.4",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "@intlayer/svelte-compiler": "workspace:*",
    "@intlayer/vue-compiler": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@intlayer/svelte-compiler": {
      "optional": true
    },
    "@intlayer/vue-compiler": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=14.18"
  },
  "bug": {
    "url": "https://github.com/aymericzip/intlayer/issues"
  }
}
