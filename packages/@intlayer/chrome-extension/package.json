{
  "name": "@intlayer/chrome-extension",
  "version": "9.5.6",
  "private": true,
  "description": "Chrome extension that inspects the i18n implementation of the current website (framework, i18n library, locales, SEO tags) and runs a full Intlayer scan through the backend.",
  "keywords": [
    "intlayer",
    "chrome-extension",
    "i18n",
    "seo",
    "scanner",
    "internationalization"
  ],
  "homepage": "https://intlayer.org",
  "bugs": {
    "url": "https://github.com/aymericzip/intlayer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aymericzip/intlayer.git"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Aymeric PINEAU",
    "url": "https://github.com/aymericzip"
  },
  "contributors": [
    {
      "name": "Aymeric Pineau",
      "email": "ay.pineau@gmail.com",
      "url": "https://github.com/aymericzip"
    }
  ],
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:ci": "vite build",
    "clean": "bun --bun rimraf ./dist .turbo",
    "dev": "vite build --watch",
    "format": "bun --bun biome format . --check",
    "format:fix": "bun --bun biome format --write .",
    "lint": "bun --bun biome lint .",
    "lint:fix": "bun --bun biome lint --write .",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest",
    "typecheck": "tsc --noEmit",
    "zip": "cd dist && zip -r ../intlayer-chrome-extension.zip . -x '*/.*' '.*'"
  },
  "dependencies": {
    "@intlayer/core": "workspace:*",
    "@intlayer/design-system": "workspace:*",
    "fuse.js": "7.5.0",
    "intlayer": "workspace:*",
    "lucide-react": "1.47.0",
    "preact": "10.29.8",
    "preact-intlayer": "workspace:*"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@tailwindcss/aspect-ratio": "0.4.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/chrome": "0.3.0",
    "rimraf": "6.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vite-intlayer": "workspace:*",
    "vitest": "5.0.1"
  }
}
