{
  "manifest_version": 3,
  "name": "Intlayer i18n Scanner",
  "version": "9.8.4",
  "description": "Inspect the i18n setup of any website: framework, i18n library, locales, hreflang and SEO tags, plus a full Intlayer audit.",
  "action": {
    "default_title": "Open Intlayer i18n Scanner",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "sidebar_action": {
    "default_panel": "popup.html",
    "default_title": "Intlayer i18n Scanner",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "open_at_install": false
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"],
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["activeTab", "scripting", "sidePanel"],
  "host_permissions": ["https://back.intlayer.org/*"],
  "optional_host_permissions": ["<all_urls>"],
  "browser_specific_settings": {
    "gecko": {
      "id": "i18n-scanner@intlayer.org",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["browsingActivity"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
