{
  "manifest_version": 3,
  "name": "Intlayer i18n Scanner",
  "version": "9.5.9",
  "description": "Inspect the i18n setup of any website: framework, i18n library, locales, hreflang and SEO tags, plus a full Intlayer audit.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://back.intlayer.org/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "i18n-scanner@intlayer.org",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["browsingActivity"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
