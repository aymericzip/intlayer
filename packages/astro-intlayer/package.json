{
  "name": "astro-intlayer",
  "version": "9.5.6",
  "private": false,
  "description": "Easily internationalize i18n your Astro applications with type-safe multilingual content management.",
  "keywords": [
    "intlayer",
    "internationalization",
    "i18n",
    "typescript",
    "astro",
    "astro-integration",
    "astro-component",
    "withastro",
    "devtools",
    "astro-loader",
    "tooling",
    "a11y"
  ],
  "homepage": "https://intlayer.org",
  "bugs": {
    "url": "https://github.com/aymericzip/intlayer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aymericzip/intlayer.git"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Aymeric PINEAU",
    "url": "https://github.com/aymericzip"
  },
  "contributors": [
    {
      "name": "Aymeric Pineau",
      "email": "ay.pineau@gmail.com",
      "url": "https://github.com/aymericzip"
    }
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "node": {
        "require": "./dist/cjs/index.cjs",
        "import": "./dist/esm/index.mjs"
      },
      "bun": {
        "require": "./dist/cjs/index.cjs",
        "import": "./dist/esm/index.mjs"
      },
      "deno": {
        "require": "./dist/cjs/index.cjs",
        "import": "./dist/esm/index.mjs"
      },
      "workerd": {
        "require": "./dist/cjs/index.cjs",
        "import": "./dist/esm/index.mjs"
      },
      "worker": {
        "require": "./dist/cjs/index.cjs",
        "import": "./dist/esm/index.mjs"
      },
      "edge-light": {
        "require": "./dist/cjs/index.cjs",
        "import": "./dist/esm/index.mjs"
      },
      "browser": {
        "require": "./dist/cjs/client/index.cjs",
        "import": "./dist/esm/client/index.mjs"
      },
      "require": "./dist/cjs/index.cjs",
      "import": "./dist/esm/index.mjs"
    },
    "./client": {
      "types": "./dist/types/client/index.d.ts",
      "require": "./dist/cjs/client/index.cjs",
      "import": "./dist/esm/client/index.mjs"
    },
    "./client/locale-redirect": {
      "types": "./dist/types/client/localeRedirect.d.ts",
      "require": "./dist/cjs/client/localeRedirect.cjs",
      "import": "./dist/esm/client/localeRedirect.mjs"
    },
    "./integration": {
      "types": "./dist/types/integration.d.ts",
      "require": "./dist/cjs/integration.cjs",
      "import": "./dist/esm/integration.mjs"
    },
    "./middleware": {
      "types": "./dist/types/middleware.d.ts",
      "require": "./dist/cjs/middleware.cjs",
      "import": "./dist/esm/middleware.mjs"
    },
    "./format": {
      "types": "./dist/types/format/index.d.ts",
      "browser": {
        "require": "./dist/cjs/client/format/index.cjs",
        "import": "./dist/esm/client/format/index.mjs"
      },
      "require": "./dist/cjs/format/index.cjs",
      "import": "./dist/esm/format/index.mjs"
    },
    "./html": {
      "types": "./dist/types/html/index.d.ts",
      "require": "./dist/cjs/html/index.cjs",
      "import": "./dist/esm/html/index.mjs"
    },
    "./markdown": {
      "types": "./dist/types/markdown/index.d.ts",
      "require": "./dist/cjs/markdown/index.cjs",
      "import": "./dist/esm/markdown/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.mjs",
  "types": "dist/types/index.d.ts",
  "typesVersions": {
    "*": {
      "client": [
        "./dist/types/client/index.d.ts"
      ],
      "client/locale-redirect": [
        "./dist/types/client/localeRedirect.d.ts"
      ],
      "format": [
        "./dist/types/format/index.d.ts"
      ],
      "html": [
        "./dist/types/html/index.d.ts"
      ],
      "markdown": [
        "./dist/types/markdown/index.d.ts"
      ],
      "middleware": [
        "./dist/types/middleware.d.ts"
      ],
      "package.json": [
        "./package.json"
      ],
      "integration": [
        "./dist/types/integration.d.ts"
      ]
    }
  },
  "files": [
    "./dist",
    "./package.json"
  ],
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "build:ci": "tsdown --config tsdown.config.ts",
    "clean": "bun --bun rimraf ./dist .turbo",
    "dev": "tsdown --config tsdown.config.ts --watch",
    "format": "bun --bun biome format . --check",
    "format:fix": "bun --bun biome format --write .",
    "lint": "bun --bun biome lint .",
    "lint:fix": "bun --bun biome lint --write .",
    "prepublish": "cp -f ../../README.md ./README.md",
    "publish": "bun publish || true",
    "publish:canary": "bun publish --access public --tag canary || true",
    "publish:ci": "bun ../../scripts/publish-package.mjs",
    "publish:latest": "bun publish --access public --tag latest || true",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest",
    "typecheck": "tsc --noEmit --project tsconfig.types.json"
  },
  "dependencies": {
    "@intlayer/config": "workspace:*",
    "@intlayer/core": "workspace:*",
    "@intlayer/engine": "workspace:*",
    "@intlayer/types": "workspace:*",
    "vanilla-intlayer": "workspace:*",
    "vite-intlayer": "workspace:*"
  },
  "devDependencies": {
    "@intlayer/dictionaries-entry": "workspace:*",
    "@types/node": "^22",
    "@utils/ts-config": "workspace:*",
    "@utils/ts-config-types": "workspace:*",
    "@utils/tsdown-config": "workspace:*",
    "fast-glob": "3.3.3",
    "rimraf": "6.1.3",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "peerDependencies": {
    "astro": ">=4.0.0",
    "vite": ">=4.0.0"
  },
  "engines": {
    "node": ">=14.18"
  },
  "bug": {
    "url": "https://github.com/aymericzip/intlayer/issues"
  }
}
