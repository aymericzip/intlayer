{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@utils/ts-config-types",
  "include": ["src/**/*", "types/**/*"],
  "exclude": ["**/*.test.*"],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "dist/types",
    // Elysia marks a derive `Partial` when its value may be `undefined`, which
    // is always the case without null checks: `intlayer` would be optional.
    "strictNullChecks": true
  }
}
