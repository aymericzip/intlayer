{
  "name": "svelte-intlayer",
  "version": "9.7.1",
  "description": "Easily internationalize i18n your Svelte applications with type-safe multilingual content management.",
  "keywords": [
    "data",
    "i18n",
    "internationalization",
    "intlayer",
    "multilingual",
    "svelte",
    "typescript"
  ],
  "homepage": "https://intlayer.org",
  "bugs": {
    "url": "https://github.com/aymericzip/intlayer/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Aymeric PINEAU",
    "url": "https://github.com/aymericzip"
  },
  "contributors": [
    {
      "name": "Aymeric Pineau",
      "email": "ay.pineau@gmail.com",
      "url": "https://github.com/aymericzip"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aymericzip/intlayer.git"
  },
  "files": [
    "./dist",
    "./package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./markdown": {
      "types": "./dist/markdown/index.d.ts",
      "svelte": "./dist/markdown/index.js",
      "default": "./dist/markdown/index.js"
    },
    "./html": {
      "types": "./dist/html/index.d.ts",
      "svelte": "./dist/html/index.js",
      "default": "./dist/html/index.js"
    },
    "./format": {
      "types": "./dist/format/index.d.ts",
      "svelte": "./dist/format/index.js",
      "default": "./dist/format/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "build:ci": "svelte-package -i src -o dist",
    "check": "svelte-check --tsconfig ./tsconfig.types.json",
    "clean": "bun --bun rimraf ./dist .turbo",
    "dev": "svelte-package -i src -o dist --watch",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "prepublish": "cp -f ../../README.md ./README.md",
    "publish": "bun publish || true",
    "publish:canary": "bun publish --access public --tag canary || true",
    "publish:ci": "bun ../../scripts/publish-package.mjs",
    "publish:latest": "bun publish --access public --tag latest || true",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest",
    "typecheck": "tsc --noEmit --project tsconfig.types.json"
  },
  "dependencies": {
    "@intlayer/api": "workspace:*",
    "@intlayer/config": "workspace:*",
    "@intlayer/core": "workspace:*",
    "@intlayer/editor": "workspace:*",
    "@intlayer/types": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "8.0.0",
    "@sveltejs/package": "3.0.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "^26",
    "@utils/ts-config": "workspace:*",
    "@utils/ts-config-types": "workspace:*",
    "@utils/tsdown-config": "workspace:*",
    "rimraf": "6.1.4",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "tsdown": "0.23.7",
    "typescript": "5.9.3",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "svelte": ">=5.0.0"
  },
  "optionalDependencies": {
    "@intlayer/analytics": "workspace:*"
  },
  "engines": {
    "node": ">=14.18"
  }
}
