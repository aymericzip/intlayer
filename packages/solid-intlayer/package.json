{
  "name": "solid-intlayer",
  "version": "9.7.3",
  "private": false,
  "description": "Easily internationalize i18n your Solid applications with type-safe multilingual content management.",
  "keywords": [
    "data",
    "i18n",
    "internationalization",
    "intlayer",
    "multilingual",
    "solid",
    "typescript"
  ],
  "homepage": "https://intlayer.org",
  "bugs": {
    "url": "https://github.com/aymericzip/intlayer/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Aymeric PINEAU",
    "url": "https://github.com/aymericzip"
  },
  "contributors": [
    {
      "name": "Aymeric Pineau",
      "email": "ay.pineau@gmail.com",
      "url": "https://github.com/aymericzip"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aymericzip/intlayer.git"
  },
  "files": [
    "./dist",
    "./package.json"
  ],
  "sideEffects": false,
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.mjs",
  "types": "dist/types/index.d.ts",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types/index.d.ts"
      ],
      "html": [
        "./dist/types/html/index.d.ts"
      ],
      "markdown": [
        "./dist/types/markdown/index.d.ts"
      ],
      "format": [
        "./dist/types/format/index.d.ts"
      ],
      "server": [
        "./dist/types/server/index.d.ts"
      ],
      "package.json": [
        "./package.json"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "solid": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs",
      "import": "./dist/esm/index.mjs"
    },
    "./html": {
      "types": "./dist/types/html/index.d.ts",
      "solid": "./dist/esm/html/index.mjs",
      "require": "./dist/cjs/html/index.cjs",
      "import": "./dist/esm/html/index.mjs"
    },
    "./markdown": {
      "types": "./dist/types/markdown/index.d.ts",
      "solid": "./dist/esm/markdown/index.mjs",
      "require": "./dist/cjs/markdown/index.cjs",
      "import": "./dist/esm/markdown/index.mjs"
    },
    "./format": {
      "types": "./dist/types/format/index.d.ts",
      "solid": "./dist/esm/format/index.mjs",
      "require": "./dist/cjs/format/index.cjs",
      "import": "./dist/esm/format/index.mjs"
    },
    "./server": {
      "types": "./dist/types/server/index.d.ts",
      "solid": "./dist/esm/server/index.mjs",
      "require": "./dist/cjs/server/index.cjs",
      "import": "./dist/esm/server/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun --bun vite build",
    "build:ci": "bun --bun vite build",
    "clean": "bun --bun rimraf ./dist .turbo",
    "dev": "bun --bun vite build --watch",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "prepublish": "cp -f ../../README.md ./README.md",
    "publish": "bun publish || true",
    "publish:canary": "bun publish --access public --tag canary || true",
    "publish:ci": "bun ../../scripts/publish-package.mjs",
    "publish:latest": "bun publish --access public --tag latest || true",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest",
    "typecheck": "tsc --noEmit --project tsconfig.types.json"
  },
  "dependencies": {
    "@intlayer/api": "workspace:*",
    "@intlayer/config": "workspace:*",
    "@intlayer/core": "workspace:*",
    "@intlayer/editor": "workspace:*",
    "@intlayer/types": "workspace:*"
  },
  "devDependencies": {
    "@solidjs/testing-library": "0.8.10",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^26",
    "@typescript/typescript6": "^6.0.2",
    "@utils/ts-config": "workspace:*",
    "@utils/ts-config-types": "workspace:*",
    "@utils/tsdown-config": "workspace:*",
    "jsdom": "30.1.3",
    "rimraf": "6.1.4",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-plugin-dts": "5.1.2",
    "vite-plugin-solid": "2.11.15",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "solid-js": ">=1.0.0"
  },
  "optionalDependencies": {
    "@intlayer/analytics": "workspace:*"
  },
  "engines": {
    "node": ">=14.18"
  },
  "bug": {
    "url": "https://github.com/aymericzip/intlayer/issues"
  }
}
