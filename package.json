{
  "name": "intlayer-monorepo",
  "version": "9.7.3",
  "private": false,
  "description": "Intlayer monorepo - Layer of abstraction between the business logic and the data access layer. Manage internationalization in a simple way, through TypeScript, JavaScript or JSON declaration file.",
  "homepage": "https://intlayer.org",
  "bugs": {
    "url": "https://github.com/aymericzip/intlayer/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Aymeric PINEAU",
    "url": "https://github.com/aymericzip"
  },
  "contributors": [
    {
      "name": "Aymeric Pineau",
      "email": "ay.pineau@gmail.com",
      "url": "https://github.com/aymericzip"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aymericzip/intlayer.git"
  },
  "workspaces": [
    "./docs",
    "./apps/*",
    "./packages/**/*",
    "./utils/*",
    "./examples/*",
    "./plugins/*",
    "./compat/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo build '--filter=./packages/**' '--filter=./docs'",
    "build:ci": "turbo build:ci '--filter=./packages/**' '--filter=./docs' '--filter=./plugins/**' '--filter=./compat/**'",
    "check": "oxlint . && oxfmt --check .",
    "check:fix": "oxlint --fix . && oxfmt .",
    "clean": "turbo clean '--filter=./packages/**' '--filter=./docs'",
    "clean:node_modules": "bun --bun rimraf node_modules ./**/node_modules",
    "clean:packages:node_modules": "bun --bun rimraf ./**/node_modules",
    "dev": "bun ./scripts/script-dev-package-command.mjs --command build",
    "dev:pick": "bun ./scripts/script-pick.mjs --command dev",
    "docker:app:build": "./scripts/docker-build-app.sh",
    "docker:app:start": "docker run --rm -p 3000:3000 --name intlayer-app-app intlayer-app",
    "docker:backend:build": "docker build -t intlayer-backend -f ./apps/backend/Dockerfile --progress=plain .",
    "docker:backend:start": "docker run --rm -p 3100:3100 --name intlayer-backend-app intlayer-backend",
    "docker:design-system:build": "docker build -t intlayer-design-system -f ./packages/@intlayer/design-system/Dockerfile --progress=plain .",
    "docker:design-system:start": "docker run --rm -p 6006:6006 --name intlayer-design-system-app intlayer-design-system",
    "docker:marketplace:build": "docker build -t intlayer-marketplace -f ./apps/marketplace/Dockerfile --progress=plain .",
    "docker:marketplace:start": "docker run --rm -p 3300:3300 --name intlayer-marketplace-app intlayer-marketplace",
    "docker:mcp:build": "docker build -t intlayer-mcp -f ./packages/@intlayer/mcp/Dockerfile --progress=plain .",
    "docker:mcp:start": "docker run --rm -p 3000:3000 --name intlayer-mcp-app intlayer-mcp",
    "docker:showcase:build": "docker build -t intlayer-showcase -f ./apps/showcase/Dockerfile --progress=plain .",
    "docker:showcase:start": "docker run --rm -p 3100:3100 --name intlayer-showcase-app intlayer-showcase",
    "docker:website:build": "./scripts/docker-build-website.sh",
    "docker:website:start": "docker run --rm -p 3000:3000 --name intlayer-website-app intlayer-website",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "install:packages": "bun install --filter '!./examples/**' --filter '!./apps/website/**'",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "lint-staged": "lint-staged --allow-empty",
    "prepare": "husky",
    "prepare:publish": "bun run clean && bun install && bun run build",
    "prepublish_": "bun turbo prepublish '--filter=./packages/**' '--filter=./docs' '--filter=./plugins/**' '--filter=./compat/**'",
    "prepublish": "turbo prepublish '--filter=./packages/**' '--filter=./docs'",
    "publish": "bun turbo publish '--filter=./packages/**' '--filter=./docs' '--filter=./apps/app' '--filter=./plugins/**' '--filter=./compat/**'",
    "publish:canary": "bun run prepare:publish && turbo publish:canary '--filter=./packages/@intlayer/design-system' && turbo publish:canary '--filter=./packages/**' '--filter=!@intlayer/design-system' '--filter=./docs' '--filter=./plugins/**' '--filter=./compat/**'",
    "publish:canary:ok": "bun turbo publish:canary '--filter=./packages/@intlayer/design-system' && turbo publish:canary '--filter=./packages/**' '--filter=!@intlayer/design-system' '--filter=./docs' '--filter=./plugins/**' '--filter=./compat/**'",
    "publish:ci": "bun turbo publish:ci --continue --concurrency=100 '--filter=./packages/**' '--filter=!@intlayer/design-system' '--filter=./docs' '--filter=./plugins/**' '--filter=./compat/**'",
    "publish:ci:build": "bun turbo build prepublish '--filter=./packages/**' '--filter=!@intlayer/design-system' '--filter=./docs' '--filter=./plugins/**' '--filter=./compat/**'",
    "publish:latest": "bun run prepare:publish && bun run publish:latest:ok",
    "publish:latest:ok": "bun turbo publish:latest '--filter=./packages/@intlayer/design-system' && turbo publish:latest '--filter=./packages/**' '--filter=!@intlayer/design-system' '--filter=./docs' '--filter=./plugins/**' '--filter=./compat/**'",
    "test": "bun turbo test '--filter=./packages/**' '--filter=./docs' '--filter=./plugins/**' '--filter=./compat/**' --concurrency=2",
    "test:pick": "bun ./scripts/script-pick.mjs --command test",
    "typecheck": "bun turbo typecheck '--filter=./packages/**' '--filter=./docs' '--filter=./plugins/**' '--filter=./compat/**' --concurrency=1"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@parcel/watcher": "2.6.0",
    "@utils/ts-config": "workspace:*",
    "@utils/ts-config-types": "workspace:*",
    "@utils/tsdown-config": "workspace:*",
    "@vitejs/plugin-react": "6.3.0",
    "bun": "1.4.4",
    "enquirer": "2.4.1",
    "fast-glob": "3.3.3",
    "husky": "9.1.7",
    "intlayer": "workspace:*",
    "lint-staged": "17.6.0",
    "minimist": "1.2.8",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "rimraf": "6.1.4",
    "rollup-plugin-visualizer": "7.1.3",
    "tsdown": "0.23.7",
    "tslib": "2.9.1",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "resolutions": {
    "bson": "7.2.0",
    "preact": "11.2.0",
    "prosemirror-model": "1.25.12",
    "prosemirror-transform": "1.12.4",
    "prosemirror-view": "1.42.9",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=16.0.0"
  },
  "packageManager": "bun@1.4.4",
  "bug": {
    "url": "https://github.com/aymericzip/intlayer/issues"
  },
  "patchedDependencies": {
    "@tanstack/redact@0.3.1": "patches/@tanstack%2Fredact@0.3.1.patch"
  }
}
