# The Docker images build a single workspace and install every published
# `@intlayer/*` package from the npm registry (see
# docker/scripts/prepareStandaloneWorkspace.ts), so the build context only needs
# the root manifest, `utils/`, `docker/scripts/` and the workspace being built.
# Everything excluded below is either rebuilt in the image, fetched from the
# registry, or irrelevant to a build — keeping it out of the context is the
# cheapest speed-up available, since the whole context is uploaded to the daemon
# before the first instruction runs.

# Dependencies (will be installed fresh in container)
node_modules/
**/node_modules/

# Build output
dist/
**/dist/
build/
**/build/
**/.output/
**/.vinxi/
**/.tanstack/
**/storybook-static/

# Git history and cache files
.git/
.gitignore
.github/
.husky/
.changeset/

# IDE, editor and agent tooling
.vscode/
.cursor/
.claude/
.claude-plugin/
.fallow/
# NB: `.agents/` is deliberately kept — apps/website and apps/website-tanstack
# import `.agents/skills/*/SKILL.md` to publish /.well-known/agent-skills/.
*.code-workspace
.DS_Store
**/.DS_Store

# Cache and temporary files
.eslintcache
*.log
*.tmp
*.map
*.temp
.cache/
.turbo
**/.turbo/

# Intlayer
**/.intlayer/

# Next
**/.next/

# Development and testing files (not needed for build)
coverage/
**/coverage/
.nyc_output/
test-results/
tests/

# Documentation (not needed for package build)
README.md
CONTRIBUTING.md
LICENSE
**/README.md

# Workspaces that no image builds from source. `docs/` itself must stay: the
# self-host image still builds from the monorepo and copies `docs/<kind>/en/`.
# Its `assets/` tree is ~53 MB and is not part of the published tarball either.
docs/assets/
examples/
plugins/
compat/

# Linting and formatting configs (already copied via package manifests)
.prettierrc.*
.prettierignore
.lintstagedrc
eslint.config.*
commitlint.config.*
biome.json
.biome

# TypeScript and build configs at root (packages have their own)
tsconfig.json

vitest.config.ts
**/*.test.*
**/*.spec.*
# NB: *.stories.* files are deliberately kept — the design-system image builds
# Storybook from them.
**/*.README.md*

# Rust Cargo build artifacts (can be multiple hundreds of MB and are not needed in Docker)
**/target/
# Keep the plugin binary that is needed at runtime
!**/target/wasm32-wasip1/release/intlayer_swc_plugin.wasm

# Environment variables
.env
**/.env
.env.*
**/.env.*
