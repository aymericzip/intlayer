    "watch": "bun --bun vite build --watch"
  },
  "dependencies": {
    "@analogjs/router": "2.9.7",
    "@angular/animations": "22.3.0",
    "@angular/common": "22.3.0",
    "@angular/compiler": "22.3.0",
    "@angular/core": "22.3.0",
    "@angular/forms": "22.3.0",
    "@angular/platform-browser": "22.3.0",
    "@angular/platform-server": "22.3.0",
    "@angular/router": "22.3.0",
    "@tailwindcss/vite": "4.3.5",
    "angular-intlayer": "workspace:*",
    "h3": "1.15.0",
    "intlayer": "workspace:*",
    "postcss": "8.5.33",
    "rxjs": "~7.8.2",
    "tailwindcss": "4.3.5",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@analogjs/platform": "2.9.7",
    "@analogjs/vite-plugin-angular": "2.9.7",
