{
  "name": "tanstack-start-intlayer",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "bun --bun vite dev --port 3000",
    "start": "bun .output/server/index.mjs",
    "build": "bun --bun vite build",
    "serve": "bun --bun vite preview",
    "test": "bun --bun vitest run",
    "typecheck": "tsc --noEmit --project tsconfig.types.json",
    "start:editor": "bun intlayer-editor start -e development",
    "intlayer:build": "intlayer build"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.103.1",
    "@tanstack/react-router": "1.170.38",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.168.56",
    "@tanstack/router-plugin": "1.168.40",
    "intlayer": "workspace:*",
    "nitro": "latest",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-intlayer": "workspace:*",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vite-intlayer": "workspace:*",
    "vitest": "5.0.1",
    "web-vitals": "6.1.0"
  }
}
