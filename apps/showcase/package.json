{
  "name": "intlayer-showcase",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "imports": {
    "#/*": "./src/*",
    "#components/*": "./src/components/*",
    "#layouts/*": "./src/layouts/*",
    "#utils/*": "./src/utils/*",
    "#hooks/*": "./src/hooks/*",
    "#assets/*": "./src/assets/*",
    "#structuredData/*": "./src/structuredData/*"
  },
  "scripts": {
    "build": "bun --bun vite build",
    "postbuild": "bun scripts/compress-static.ts",
    "check": "bun --bun biome check",
    "dev": "bun --bun vite dev --port 3200",
    "format": "bun --bun biome format",
    "lint": "bun --bun biome lint",
    "preview": "bun --bun vite preview",
    "start": "bun run .output/server/index.mjs",
    "test": "bun --bun vitest run"
  },
  "dependencies": {
    "@intlayer/api": "workspace:*",
    "@intlayer/config": "workspace:*",
    "@intlayer/core": "workspace:*",
    "@intlayer/design-system": "workspace:*",
    "@intlayer/types": "workspace:*",
    "@posthog/react": "1.11.3",
    "@resvg/resvg-wasm": "2.6.2",
    "@tailwindcss/aspect-ratio": "0.4.2",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/match-sorter-utils": "9.2.6",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-query-persist-client": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.168.60",
    "@tanstack/react-table": "9.2.6",
    "@tanstack/router-plugin": "1.168.42",
    "framer-motion": "14.0.0",
    "fuse.js": "7.5.0",
    "intlayer": "workspace:*",
    "lucide-react": "1.52.0",
    "nitro": "latest",
    "posthog-js": "^1.434.15",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "react-intlayer": "workspace:*",
    "satori": "0.35.0",
    "server-only": "0.0.1",
    "tailwindcss": "4.3.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "0.8.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^26",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.0.1",
    "oxc-transform-react": "^0.153.0",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vite-intlayer": "workspace:*",
    "vite-plugin-wasm": "3.6.0",
    "vitest": "5.0.3"
  }
}
