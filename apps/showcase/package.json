{
  "name": "intlayer-showcase",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "imports": {
    "#/*": "./src/*",
    "#components/*": "./src/components/*",
    "#layouts/*": "./src/layouts/*",
    "#utils/*": "./src/utils/*",
    "#hooks/*": "./src/hooks/*",
    "#assets/*": "./src/assets/*",
    "#structuredData/*": "./src/structuredData/*"
  },
  "scripts": {
    "build": "bun --bun vite build",
    "postbuild": "bun scripts/compress-static.ts",
    "check": "bun --bun biome check",
    "dev": "bun --bun vite dev --port 3200",
    "format": "bun --bun biome format",
    "lint": "bun --bun biome lint",
    "preserve": "bun --env-file=.env.production ./scripts/purge-cloudflare-cache.ts",
    "preview": "bun --bun vite preview",
    "start": "bun run .output/server/index.mjs",
    "test": "bun --bun vitest run"
  },
  "dependencies": {
    "@intlayer/api": "workspace:*",
    "@intlayer/config": "workspace:*",
    "@intlayer/core": "workspace:*",
    "@intlayer/design-system": "workspace:*",
    "@intlayer/types": "workspace:*",
    "@posthog/react": "1.10.5",
    "@rolldown/plugin-babel": "0.2.3",
    "@tailwindcss/aspect-ratio": "0.4.2",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/match-sorter-utils": "9.1.2",
    "@tanstack/react-devtools": "0.10.12",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-query-devtools": "5.102.8",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-router-devtools": "1.167.1",
    "@tanstack/react-router-ssr-query": "1.167.2",
    "@tanstack/react-start": "1.168.49",
    "@tanstack/react-table": "9.2.4",
    "@tanstack/router-plugin": "1.168.35",
    "framer-motion": "13.2.0",
    "fuse.js": "7.5.0",
    "intlayer": "workspace:*",
    "lucide-react": "1.40.0",
    "nitro": "latest",
    "posthog-js": "1.426.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "react-intlayer": "workspace:*",
    "server-only": "0.0.1",
    "tailwindcss": "4.3.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "0.8.5",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "30.0.1",
    "remark-gfm": "4.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-intlayer": "workspace:*",
    "vite-plugin-wasm": "3.6.0",
    "vitest": "5.0.0"
  }
}
