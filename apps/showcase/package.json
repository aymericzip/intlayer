{
  "name": "intlayer-showcase",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "imports": {
    "#/*": "./src/*",
    "#components/*": "./src/components/*",
    "#layouts/*": "./src/layouts/*",
    "#utils/*": "./src/utils/*",
    "#hooks/*": "./src/hooks/*",
    "#assets/*": "./src/assets/*",
    "#structuredData/*": "./src/structuredData/*"
  },
  "scripts": {
    "build": "bun --bun vite build",
    "check": "bun --bun biome check",
    "dev": "bun --bun vite dev --port 3200",
    "format": "bun --bun biome format",
    "lint": "bun --bun biome lint",
    "preserve": "bun --env-file=.env.production ./scripts/purge-cloudflare-cache.ts",
    "preview": "bun --bun vite preview",
    "start": "bun run .output/server/index.mjs",
    "test": "bun --bun vitest run"
  },
  "dependencies": {
    "@intlayer/api": "workspace:*",
    "@intlayer/config": "workspace:*",
    "@intlayer/core": "workspace:*",
    "@intlayer/design-system": "workspace:*",
    "@intlayer/types": "workspace:*",
    "@posthog/react": "1.10.3",
    "@rolldown/plugin-babel": "0.2.3",
    "@tailwindcss/aspect-ratio": "0.4.2",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/match-sorter-utils": "9.0.0",
    "@tanstack/react-devtools": "0.10.10",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-query-devtools": "5.101.4",
    "@tanstack/react-router": "1.170.25",
    "@tanstack/react-router-devtools": "1.167.1",
    "@tanstack/react-router-ssr-query": "1.167.1",
    "@tanstack/react-start": "1.168.42",
    "@tanstack/react-table": "9.0.0",
    "@tanstack/router-plugin": "1.168.29",
    "framer-motion": "13.1.0",
    "fuse.js": "7.5.0",
    "intlayer": "workspace:*",
    "lucide-react": "1.31.0",
    "next-themes": "0.4.6",
    "nitro": "latest",
    "posthog-js": "1.415.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.85.0",
    "react-intlayer": "workspace:*",
    "server-only": "0.0.1",
    "tailwindcss": "4.3.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "0.8.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "30.0.1",
    "remark-gfm": "4.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vite-intlayer": "workspace:*",
    "vite-plugin-wasm": "3.6.0",
    "vitest": "4.1.10"
  }
}
