{
  "name": "website-tanstack",
  "version": "9.8.0-canary.1",
  "private": true,
  "description": "Intlayer Website include the landing page and the documentation of the intlayer project.",
  "keywords": [
    "application",
    "editor",
    "file",
    "intlayer",
    "javascript",
    "json",
    "typescript",
    "website"
  ],
  "homepage": "https://intlayer.org",
  "bugs": {
    "url": "https://github.com/aymericzip/intlayer/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Aymeric PINEAU",
    "url": "https://github.com/aymericzip"
  },
  "contributors": [
    {
      "name": "Aymeric Pineau",
      "email": "ay.pineau@gmail.com",
      "url": "https://github.com/aymericzip"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aymericzip/intlayer.git"
  },
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "baidu-push": "bun --env-file=.env.production.local ./scripts/baidu-push.ts",
    "build": "bun --bun vite build",
    "postbuild": "bun --smol scripts/inline-critical-css.ts && bun --smol scripts/generate-sw.ts && (bun --smol scripts/compress-static.ts || echo '⚠️  pre-compression skipped (non-fatal) — assets ship uncompressed')",
    "dev": "bun --bun vite dev",
    "editor": "bun x intlayer-editor start --bun",
    "generate-pwa-assets": "pwa-asset-generator --preset minimal ../../packages/@intlayer/design-system/src/components/Logo/logo_circle_wite.svg ./public/assets/",
    "serve": "npx intlayer serve --bun",
    "start": "bun run .output/server/index.mjs",
    "start:editor": "bun x intlayer-editor start --with 'bun --bun vite dev'",
    "test": "bun --bun vitest run"
  },
  "dependencies": {
    "@fontsource/geist-sans": "^5.3.0",
    "@intlayer/analytics": "workspace:*",
    "@intlayer/api": "workspace:*",
    "@intlayer/backend-contract": "workspace:*",
    "@intlayer/config": "workspace:*",
    "@intlayer/core": "workspace:*",
    "@intlayer/design-system": "workspace:*",
    "@intlayer/dictionaries-entry": "workspace:*",
    "@intlayer/docs": "workspace:*",
    "@intlayer/editor-react": "workspace:*",
    "@intlayer/engine": "workspace:*",
    "@intlayer/types": "workspace:*",
    "@resvg/resvg-wasm": "2.6.2",
    "@shikijs/transformers": "4.6.0",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.5",
    "@tanstack/redact": "0.3.1",
    "@tanstack/start-static-server-functions": "1.167.44",
    "chart.js": "4.6.1",
    "defu": "6.1.7",
    "framer-motion": "14.14.0",
    "fuse.js": "7.5.0",
    "intlayer": "workspace:*",
    "lucide-react": "1.72.0",
    "nitro": "latest",
    "node-html-markdown": "2.0.0",
    "node-html-parser": "9.0.7",
    "oxc-transform-react": "0.158.0",
    "posthog-js": "^1.447.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-intlayer": "workspace:*",
    "rss": "1.2.2",
    "satori": "0.63.2",
    "shiki": "4.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/router-plugin": "1.169.0",
    "@types/node": "^26",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/rss": "0.0.32",
    "@utils/ts-config": "workspace:*",
    "@utils/ts-config-types": "workspace:*",
    "@utils/tsdown-config": "workspace:*",
    "@vitejs/plugin-react": "6.3.0",
    "pwa-asset-generator": "8.1.7",
    "raw-loader": "4.0.2",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-intlayer": "workspace:*",
    "workbox-build": "7.4.1"
  },
  "peerDependencies": {},
  "peerDependenciesMeta": {},
  "optionalDependencies": {
    "@react-spring/web": "10.1.2",
    "cobe": "2.0.1"
  }
}
