    "@posthog/react": "1.11.3",
    "@resvg/resvg-wasm": "2.6.2",
    "@stripe/connect-js": "3.5.0",
    "@stripe/react-connect-js": "3.5.0",
    "@stripe/react-stripe-js": "7.0.1",
    "@stripe/stripe-js": "10.2.1",
    "@tailwindcss/aspect-ratio": "0.4.2",
    "@tailwindcss/vite": "4.3.4",
    "@tanstack/match-sorter-utils": "9.2.6",
    "@tanstack/react-devtools": "0.10.14",
