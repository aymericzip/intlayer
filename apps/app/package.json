    "defu": "6.1.7",
    "framer-motion": "14.9.0",
    "fuse.js": "7.5.0",
    "intlayer": "workspace:*",
    "lucide-react": "1.67.0",
    "nitro": "latest",
    "posthog-js": "^1.445.1",
    "react": "19.3.1",
