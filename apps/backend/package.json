{
  "name": "@intlayer/backend",
  "version": "9.7.2",
  "private": true,
  "description": "Intlayer Backend is a an application that allow you to manage your Intlayer content and interact with the intlayer editor.",
  "keywords": [
    "api",
    "backend",
    "i18n",
    "internationalization",
    "intlayer",
    "multilingual",
    "types"
  ],
  "homepage": "https://intlayer.org",
  "bugs": {
    "url": "https://github.com/aymericzip/intlayer/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Aymeric PINEAU",
    "url": "https://github.com/aymericzip"
  },
  "contributors": [
    {
      "name": "Aymeric Pineau",
      "email": "ay.pineau@gmail.com",
      "url": "https://github.com/aymericzip"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aymericzip/intlayer.git"
  },
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "prebuild": "bun scripts/generate-embeddings.ts",
    "build": "bun --bun tsdown --config tsdown.config.ts",
    "build:ci": "bun --bun tsdown --config tsdown.config.ts",
    "clean": "bun --bun rimraf ./dist .turbo",
    "dev": "bun --watch ./src/index.ts",
    "email": "email dev --dir ./src/emails",
    "embeddings:generate": "bun scripts/generate-embeddings.ts",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "start": "cross-env NODE_ENV=production node dist/esm/index.mjs",
    "start:stripe": "stripe listen --forward-to localhost:3100/webhook/stripe",
    "test": "bun vitest run",
    "test:watch": "bun --bun vitest",
    "typecheck": "tsc --noEmit --project tsconfig.types.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1164.0",
    "@better-auth/core": "1.7.18",
    "@better-auth/passkey": "1.7.18",
    "@better-auth/sso": "1.7.18",
    "@fastify/compress": "9.3.0",
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.4.1",
    "@fastify/formbody": "9.0.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/swagger": "9.9.3",
    "@fastify/swagger-ui": "6.1.3",
    "@intlayer/ai": "workspace:*",
    "@intlayer/backend-contract": "workspace:*",
    "@intlayer/core": "workspace:*",
    "@intlayer/engine": "workspace:*",
    "@intlayer/mcp": "workspace:*",
    "@node-oauth/oauth2-server": "5.3.1",
    "@octokit/rest": "22.0.1",
    "@react-email/components": "1.0.12",
    "better-auth": "1.7.18",
    "bullmq": "6.7.2",
    "cheerio": "1.2.0",
    "cross-env": "10.1.0",
    "defu": "6.1.7",
    "dotenv": "18.0.10",
    "fastify": "5.12.8",
    "fastify-intlayer": "workspace:*",
    "fastify-type-provider-zod": "7.0.0",
    "ioredis": "6.0.0",
    "mmdb-lib": "3.0.3",
    "mongodb": "7.8.0",
    "mongoose": "9.12.0",
    "mppx": "0.17.6",
    "nodemailer": "10.4.0",
    "openai": "7.54.0",
    "puppeteer": "25.16.0",
    "react": "19.3.1",
    "react-email": "6.11.8",
    "resend": "6.37.0",
    "sharp": "0.35.5",
    "stripe": "23.1.0",
    "validator": "13.15.35",
    "winston": "3.19.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@intlayer/config": "workspace:*",
    "@intlayer/docs": "workspace:*",
    "@intlayer/types": "workspace:*",
    "@types/node": "^26",
    "@types/nodemailer": "8.0.2",
    "@types/oauth2-server": "3.0.18",
    "@types/react": "19.3.0",
    "@types/validator": "13.15.10",
    "@utils/ts-config": "workspace:*",
    "@utils/ts-config-types": "workspace:*",
    "@utils/tsdown-config": "workspace:*",
    "intlayer": "workspace:*",
    "rimraf": "6.1.4",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
