{
  "version": "2.0.0",
  "tasks": [
    {
      // A shell task, not `"type": "npm"`: VS Code's package-manager
      // auto-detection picks yarn here, which fails on the bun
      // `packageManager` field of the monorepo root
      "type": "shell",
      "command": "bun run watch",
      "isBackground": true,
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": {
        "owner": "typescript",
        "fileLocation": "relative",
        "pattern": {
          "regexp": "^([^\\s].*)\\((\\d+|\\d+,\\d+|\\d+,\\d+,\\d+,\\d+)\\):\\s+(error|warning|info)\\s+(TS\\d+)\\s*:\\s*(.*)$",
          "file": 1,
          "location": 2,
          "severity": 3,
          "code": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "(Build start|rebuilding)",
          // Printed by tsdown.config.ts once every bundle and asset is written
          "endsPattern": "\\[intlayer-vscode\\] build ready"
        }
      },
      "label": "watch"
    }
  ]
}
