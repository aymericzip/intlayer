{
  "name": "intlayer-vs-code-extension",
  "displayName": "Intlayer (i18n)",
  "version": "9.5.12",
  "private": false,
  "description": "Intlayer official VSCode extension. Go to definition, hover and unused-key detection for useIntlayer keys and compat libraries (i18next, react-i18next, next-i18next, next-intl, react-intl, vue-i18n, Lingui). It also provides commands, as to create dictionary files.",
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "keywords": [
    "intlayer",
    "content",
    "markdown",
    "multilingual",
    "i18n",
    "internationalization",
    "localization",
    "l10n",
    "translation",
    "vscode",
    "react",
    "nextjs",
    "vue",
    "svelte",
    "i18next",
    "react-i18next",
    "next-i18next",
    "next-intl",
    "use-intl",
    "react-intl",
    "formatjs",
    "vue-i18n",
    "lingui"
  ],
  "homepage": "https://intlayer.org",
  "bugs": {
    "url": "https://github.com/aymericzip/intlayer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aymericzip/intlayer.git",
    "directory": "apps/vscode-extension"
  },
  "license": "MIT",
  "author": {
    "name": "Aymeric PINEAU",
    "url": "https://github.com/aymericzip"
  },
  "contributors": [
    {
      "name": "Aymeric Pineau",
      "email": "ay.pineau@gmail.com",
      "url": "https://github.com/aymericzip"
    }
  ],
  "publisher": "intlayer",
  "main": "./dist/extension.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE.txt",
    "package.json",
    "icon.png",
    "logo.svg"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "compile": "tsdown",
    "format": "biome format . --check",
    "format:fix": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "package": "vsce package --no-dependencies",
    "pretest": "bun run compile && bun run lint",
    "test": "vscode-test",
    "typecheck": "tsc --noEmit",
    "vscode:login": "vsce login intlayer",
    "vscode:prepublish": "bun run compile",
    "vscode:publish": "vsce publish --no-dependencies",
    "watch": "tsdown --watch"
  },
  "contributes": {
    "commands": [
      {
        "command": "extension.buildActiveDictionary",
        "title": "Intlayer: Build Current Dictionary",
        "icon": "$(refresh)"
      },
      {
        "command": "intlayer.refreshDictionaries",
        "title": "Intlayer: Refresh Dictionaries",
        "icon": "$(refresh)"
      },
      {
        "command": "extension.fillActiveDictionary",
        "title": "Intlayer: Fill Current Dictionary",
        "icon": "$(wand)"
      },
      {
        "command": "intlayer.fillDictionary",
        "title": "Intlayer: Fill Dictionary",
        "icon": "$(wand)"
      },
      {
        "command": "intlayer.pullDictionary",
        "title": "Intlayer: Pull Dictionary",
        "icon": "$(cloud-download)"
      },
      {
        "command": "intlayer.pushDictionary",
        "title": "Intlayer: Push Dictionary",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "intlayer.extract",
        "title": "Intlayer: Extract Content to Dictionary",
        "icon": "$(file-code)"
      },
      {
        "command": "extension.createDictionaryFile.ts",
        "title": "Intlayer: Create Content File (TypeScript)",
        "icon": "$(symbol-parameter)"
      },
      {
        "command": "extension.createDictionaryFile.esm",
        "title": "Intlayer: Create Content File (ESM)",
        "icon": "$(symbol-parameter)"
      },
      {
        "command": "extension.createDictionaryFile.cjs",
        "title": "Intlayer: Create Content File (CommonJS)",
        "icon": "$(symbol-parameter)"
      },
      {
        "command": "extension.createDictionaryFile.json",
        "title": "Intlayer: Create Content File (JSON)",
        "icon": "$(symbol-parameter)"
      },
      {
        "command": "extension.createDictionaryFile",
        "title": "Intlayer: Create Content File",
        "icon": "$(new-file)"
      },
      {
        "command": "extension.buildDictionaries",
        "title": "Intlayer: Build Dictionaries",
        "icon": "$(refresh)"
      },
      {
        "command": "extension.pushDictionaries",
        "title": "Intlayer: Push Dictionaries",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "extension.pullDictionaries",
        "title": "Intlayer: Pull Dictionaries",
        "icon": "$(cloud-download)"
      },
      {
        "command": "extension.fillDictionaries",
        "title": "Intlayer: Fill Dictionaries",
        "icon": "$(wand)"
      },
      {
        "command": "extension.testDictionaries",
        "title": "Intlayer: Test Dictionaries",
        "icon": "$(beaker)"
      },
      {
        "command": "intlayer.selectEnvironment",
        "title": "Intlayer: Select Environment",
        "icon": "$(gear)"
      },
      {
        "command": "intlayer.initSkills",
        "title": "Intlayer: Setup AI Agent Skills",
        "icon": "$(gear)"
      },
      {
        "command": "intlayer.initMCP",
        "title": "Intlayer: Setup MCP",
        "icon": "$(gear)"
      },
      {
        "command": "intlayer.initProject",
        "title": "Intlayer: Initialize Project",
        "icon": "$(rocket)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "resourceFilename =~ /.*\\.content\\.(ts|tsx|js|jsx|mjs|cjs|json|jsonc|json5)$/",
          "command": "extension.buildActiveDictionary",
          "group": "navigation@902"
        },
        {
          "when": "resourceFilename =~ /.*\\.content\\.(ts|tsx|js|jsx|mjs|cjs|json|jsonc|json5)$/",
          "command": "extension.fillActiveDictionary",
          "group": "navigation@903"
        },
        {
          "when": "(editorLangId == javascript || editorLangId == javascriptreact || editorLangId == typescript || editorLangId == typescriptreact || editorLangId == vue || editorLangId == svelte || editorLangId == astro || editorLangId == html) && (resourceFilename =~ /\\.(js|jsx|mjs|cjs|ts|tsx|svelte|vue|astro|html)$/) && !(resourceFilename =~ /.*\\.content\\..*$/)",
          "command": "extension.createDictionaryFile",
          "group": "navigation@901"
        },
        {
          "when": "(editorLangId == javascript || editorLangId == javascriptreact || editorLangId == typescript || editorLangId == typescriptreact || editorLangId == vue || editorLangId == svelte || editorLangId == astro || editorLangId == html) && (resourceFilename =~ /\\.(js|jsx|mjs|cjs|ts|tsx|svelte|vue|astro|html)$/) && !(resourceFilename =~ /.*\\.content\\..*$/)",
          "command": "intlayer.extract",
          "group": "navigation@900"
        }
      ],
      "view/title": [
        {
          "command": "intlayer.refreshDictionaries",
          "when": "view == intlayer.searchBar",
          "group": "navigation@0"
        },
        {
          "command": "intlayer.initSkills",
          "when": "view == intlayer.dictionaries",
          "group": "navigation@99"
        },
        {
          "command": "intlayer.initMCP",
          "when": "view == intlayer.dictionaries",
          "group": "navigation@98"
        }
      ],
      "view/item/context": [
        {
          "command": "intlayer.fillDictionary",
          "when": "view == intlayer.dictionaries && viewItem == intlayer.file",
          "group": "inline@1"
        },
        {
          "command": "extension.buildDictionaries",
          "when": "view == intlayer.dictionaries && (viewItem == intlayer.environment || viewItem == intlayer.environment.cms)",
          "group": "inline@1"
        },
        {
          "command": "extension.fillDictionaries",
          "when": "view == intlayer.dictionaries && (viewItem == intlayer.environment || viewItem == intlayer.environment.cms)",
          "group": "inline@2"
        },
        {
          "command": "extension.testDictionaries",
          "when": "view == intlayer.dictionaries && (viewItem == intlayer.environment || viewItem == intlayer.environment.cms)",
          "group": "inline@3"
        },
        {
          "command": "intlayer.pullDictionary",
          "when": "view == intlayer.dictionaries && viewItem == intlayer.environment.cms",
          "group": "inline@4"
        },
        {
          "command": "intlayer.pushDictionary",
          "when": "view == intlayer.dictionaries && viewItem == intlayer.environment.cms",
          "group": "inline@5"
        },
        {
          "command": "intlayer.selectEnvironment",
          "when": "view == intlayer.dictionaries && (viewItem == intlayer.environment || viewItem == intlayer.environment.cms)",
          "group": "inline@6"
        }
      ]
    },
    "views": {
      "intlayer": [
        {
          "type": "webview",
          "id": "intlayer.searchBar",
          "name": "Search"
        },
        {
          "id": "intlayer.dictionaries",
          "name": "Dictionaries"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "intlayer",
          "title": "Intlayer",
          "icon": "logo.svg"
        }
      ]
    }
  },
  "activationEvents": [
    "onView:intlayer.searchBar",
    "onView:intlayer.dictionaries",
    "onCommand:intlayer.refreshDictionaries",
    "onCommand:intlayer.pullDictionary",
    "onCommand:extension.createDictionaryFile",
    "onCommand:extension.createDictionaryFile.ts",
    "onCommand:extension.createDictionaryFile.esm",
    "onCommand:extension.createDictionaryFile.cjs",
    "onCommand:extension.createDictionaryFile.json",
    "onCommand:extension.buildDictionaries",
    "onCommand:extension.buildActiveDictionary",
    "onCommand:extension.fillActiveDictionary",
    "onCommand:extension.pushDictionaries",
    "onCommand:extension.pullDictionaries",
    "onCommand:extension.fillDictionaries",
    "onCommand:extension.testDictionaries",
    "onCommand:intlayer.selectEnvironment",
    "onCommand:intlayer.extract",
    "onCommand:intlayer.initSkills",
    "onCommand:intlayer.initMCP",
    "onCommand:intlayer.initProject",
    "workspaceContains:package.json",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:vue",
    "onLanguage:svelte",
    "onLanguage:astro",
    "onLanguage:html"
  ],
  "dependencies": {
    "esbuild": "0.28.2",
    "fast-glob": "^3.3.3",
    "oxc-parser": "^0.151.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@intlayer/api": "workspace:*",
    "@intlayer/babel": "workspace:*",
    "@intlayer/cli": "workspace:*",
    "@intlayer/config": "workspace:*",
    "@intlayer/core": "workspace:*",
    "@intlayer/dictionaries-entry": "workspace:*",
    "@intlayer/engine": "workspace:*",
    "@intlayer/lsp": "workspace:*",
    "@intlayer/svelte-compiler": "workspace:*",
    "@intlayer/types": "workspace:*",
    "@intlayer/vue-compiler": "workspace:*",
    "@types/mocha": "^10.0.10",
    "@types/node": "26.6.2",
    "@types/vscode": "^1.96.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "dotenv": "^18.0.4",
    "fuse.js": "^7.5.0",
    "ovsx": "^1.2.0",
    "svelte": "^5.57.1",
    "tsdown": "0.23.0",
    "typescript": "^7.0.2",
    "vscode-languageclient": "^10.1.2"
  },
  "optionalDependencies": {
    "@oxc-parser/binding-darwin-arm64": "0.151.0",
    "@oxc-parser/binding-darwin-x64": "0.151.0",
    "@oxc-parser/binding-linux-arm64-gnu": "0.151.0",
    "@oxc-parser/binding-linux-x64-gnu": "0.151.0",
    "@oxc-parser/binding-linux-x64-musl": "0.151.0",
    "@oxc-parser/binding-win32-arm64-msvc": "0.151.0",
    "@oxc-parser/binding-win32-x64-msvc": "0.151.0"
  },
  "engines": {
    "vscode": "^1.96.1"
  },
  "icon": "icon.png"
}
