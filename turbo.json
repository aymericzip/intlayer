{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        "build/**",
        "lib/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "build:ci": {
      "dependsOn": ["^build:ci"],
      "outputs": [
        "dist/**",
        "build/**",
        "lib/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "prepublish": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "clean": {
      "cache": false
    },
    "typecheck": {
      "outputs": []
    },
    "publish": {
      "dependsOn": ["build", "prepublish"],
      "cache": false,
      "outputs": []
    },
    "publish:canary": {
      "dependsOn": ["build", "prepublish"],
      "cache": false,
      "outputs": []
    },
    "publish:latest": {
      "dependsOn": ["build", "prepublish"],
      "cache": false,
      "outputs": []
    },
    "publish:ci": {
      "dependsOn": ["build", "prepublish"],
      "cache": false,
      "outputs": [],
      "passThroughEnv": [
        "GITHUB_ACTIONS",
        "ACTIONS_ID_TOKEN_REQUEST_*",
        "NODE_AUTH_TOKEN",
        "NPM_CONFIG_*",
        "npm_config_*",
        "PUBLISH_DRY_RUN",
        "TMPDIR"
      ]
    }
  }
}
